            <TextBox HorizontalAlignment="Left" Height="20" Margin="357,240,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="24"  x:Name="SearchTrgtATxt" RenderTransformOrigin="6.221,1.92"/>
