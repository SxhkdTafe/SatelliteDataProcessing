            <ScrollBar HorizontalAlignment="Left" Height="25" Margin="76,31,0,0" VerticalAlignment="Top" Width="18" x:Name="ScrllSig"/>
            <ScrollBar HorizontalAlignment="Left" Height="26" Margin="157,30,0,0" VerticalAlignment="Top" Width="18" x:Name="ScrllMu"/>
            <TextBox HorizontalAlignment="Left" Height="24" Margin="33,31,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="43" x:Name="SigmaTxt" IsReadOnly="True"/>
            <TextBox HorizontalAlignment="Left" Height="24" Margin="114,31,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="43" x:Name="MuTxt" IsReadOnly="True"/>
